<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rakibul Rowshan — Filmmaker | Producer | Content Architect</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Inter:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root {
    --gold: #C9A96E; --gold-light: #E8D5A3; --gold-dim: rgba(201,169,110,0.12);
    --dark: #0A0A0A; --darker: #050505; --charcoal: #111111; --panel: #161616;
    --cream: #F0EBE3; --muted: #777; --green: #22c55e; --red: #C0392B;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', sans-serif; background: var(--darker); color: var(--cream);
    overflow-x: hidden; line-height: 1.6;
  }
  .grain {
    position: fixed; inset: 0; pointer-events: none; z-index: 9999; opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }
  .sprocket-strip {
    position: fixed; top: 0; width: 22px; height: 100vh; background: var(--dark);
    border-right: 1px solid #1a1a1a; z-index: 100;
    display: flex; flex-direction: column; gap: 36px; padding-top: 16px; align-items: center;
  }
  .sprocket-strip.right { left: auto; right: 0; border-right: none; border-left: 1px solid #1a1a1a; }
  .sprocket-hole { width: 10px; height: 7px; background: #2a2a2a; border-radius: 1px; animation: sprocketPulse 2.5s ease-in-out infinite; }
  @keyframes sprocketPulse { 0%,100% { opacity: 0.2; } 50% { opacity: 1; } }
  .frame-line { position: fixed; left: 28px; right: 28px; height: 1px; background: linear-gradient(90deg, transparent, rgba(201,169,110,0.12), transparent); z-index: 90; pointer-events: none; }
  .frame-line.top { top: 16px; } .frame-line.bottom { bottom: 16px; }

  .main-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 200;
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 50px; background: linear-gradient(to bottom, rgba(5,5,5,0.95), transparent); transition: all 0.4s ease;
  }
  .main-nav.scrolled { background: rgba(5,5,5,0.98); backdrop-filter: blur(12px); padding: 14px 50px; border-bottom: 1px solid #1a1a1a; }
  .nav-logo { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 900; color: var(--cream); letter-spacing: -0.5px; }
  .nav-logo span { color: var(--gold); }
  .nav-links { display: flex; gap: 32px; align-items: center; }
  .nav-links a { color: var(--muted); text-decoration: none; font-size: 12px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; transition: color 0.3s; position: relative; }
  .nav-links a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 1px; background: var(--gold); transition: width 0.3s ease; }
  .nav-links a:hover { color: var(--gold); } .nav-links a:hover::after { width: 100%; }
  .nav-cta { background: var(--gold); color: var(--dark) !important; padding: 10px 22px; border-radius: 2px; font-weight: 700 !important; font-size: 11px !important; letter-spacing: 1.5px !important; transition: all 0.3s !important; }
  .nav-cta:hover { background: var(--gold-light); transform: translateY(-2px); } .nav-cta::after { display: none !important; }

  .hero { position: relative; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 120px 60px 80px; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: 1; background: radial-gradient(ellipse at 30% 20%, #1a1510 0%, var(--darker) 60%); }
  .hero-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.25; animation: orbDrift 12s ease-in-out infinite; }
  .hero-orb.o1 { width: 500px; height: 500px; background: var(--gold); top: -150px; right: -100px; }
  .hero-orb.o2 { width: 350px; height: 350px; background: #8B4513; bottom: -100px; left: -80px; animation-delay: -6s; }
  .hero-orb.o3 { width: 200px; height: 200px; background: var(--red); top: 40%; left: 30%; opacity: 0.1; animation-delay: -3s; }
  @keyframes orbDrift { 0%,100% { transform: translate(0,0) scale(1); } 33% { transform: translate(40px,-30px) scale(1.08); } 66% { transform: translate(-20px,20px) scale(0.95); } }

  .hero-content { position: relative; z-index: 2; max-width: 900px; }
  .hero-badge { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--gold); color: var(--gold); padding: 6px 18px; font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 32px; animation: fadeInDown 1s ease-out; }
  .hero-badge .live-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s infinite; }
  .hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.8rem, 6vw, 5.5rem); font-weight: 900; line-height: 1.05; letter-spacing: -2px; margin-bottom: 16px; background: linear-gradient(135deg, var(--cream) 0%, var(--gold-light) 50%, var(--gold) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: fadeInUp 1.2s ease-out 0.3s both; }
  .hero h1 em { font-style: italic; }
  .hero-sub { font-family: 'Space Mono', monospace; font-size: 13px; color: var(--gold); letter-spacing: 5px; text-transform: uppercase; margin-bottom: 24px; animation: fadeInUp 1.2s ease-out 0.5s both; }
  .hero-desc { font-size: 16px; color: #999; line-height: 1.8; max-width: 600px; margin: 0 auto 36px; animation: fadeInUp 1.2s ease-out 0.7s both; }
  .hero-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; animation: fadeInUp 1.2s ease-out 0.9s both; }
  .btn { padding: 14px 32px; font-family: 'Space Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; border-radius: 2px; cursor: pointer; transition: all 0.35s ease; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  .btn-gold { background: var(--gold); color: var(--dark); border: none; }
  .btn-gold:hover { background: var(--gold-light); transform: translateY(-3px); box-shadow: 0 12px 40px rgba(201,169,110,0.25); }
  .btn-outline { background: transparent; color: var(--cream); border: 1px solid rgba(255,255,255,0.15); }
  .btn-outline:hover { border-color: var(--gold); color: var(--gold); transform: translateY(-3px); }
  .scroll-hint { position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; animation: bounce 2.5s infinite; }
  .scroll-hint span { font-family: 'Space Mono', monospace; font-size: 9px; color: var(--muted); letter-spacing: 4px; text-transform: uppercase; }
  .scroll-hint .scroll-bar { width: 1px; height: 50px; background: linear-gradient(to bottom, var(--gold), transparent); }

  .marquee-wrap { background: var(--charcoal); border-top: 1px solid #1a1a1a; border-bottom: 1px solid #1a1a1a; padding: 18px 0; overflow: hidden; white-space: nowrap; }
  .marquee-track { display: inline-flex; animation: marqueeScroll 35s linear infinite; }
  .marquee-item { display: inline-flex; align-items: center; gap: 10px; padding: 0 40px; font-family: 'Space Mono', monospace; font-size: 11px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; }
  .marquee-item::before { content: '◆'; color: var(--gold); font-size: 7px; }
  @keyframes marqueeScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  .section { padding: 100px 60px; max-width: 1200px; margin: 0 auto; position: relative; }
  .section-header { display: flex; align-items: center; gap: 20px; margin-bottom: 56px; }
  .sec-num { font-family: 'Space Mono', monospace; font-size: 11px; color: var(--gold); border: 1px solid var(--gold); padding: 4px 12px; }
  .sec-title { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 3.5vw, 2.8rem); font-weight: 700; color: var(--cream); }
  .sec-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--gold), transparent); min-width: 40px; }

  .timeline { position: relative; padding-left: 48px; }
  .timeline::before { content: ''; position: absolute; left: 12px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, var(--gold), rgba(201,169,110,0.1)); }
  .timeline-item { position: relative; padding-bottom: 48px; opacity: 0; transform: translateX(-20px); transition: all 0.8s ease-out; }
  .timeline-item.visible { opacity: 1; transform: translateX(0); }
  .timeline-item::before { content: ''; position: absolute; left: -42px; top: 4px; width: 16px; height: 16px; background: var(--darker); border: 2px solid var(--gold); border-radius: 50%; transition: all 0.3s; }
  .timeline-item:hover::before { background: var(--gold); transform: scale(1.2); }
  .timeline-item:last-child { padding-bottom: 0; }
  .tl-year { font-family: 'Space Mono', monospace; font-size: 12px; color: var(--gold); margin-bottom: 6px; letter-spacing: 1px; }
  .tl-title { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: var(--cream); margin-bottom: 6px; }
  .tl-role { font-size: 13px; color: var(--gold); margin-bottom: 10px; font-family: 'Space Mono', monospace; letter-spacing: 1px; }
  .tl-desc { font-size: 14px; color: #888; line-height: 1.7; max-width: 700px; }
  .tl-tags { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .tl-tag { font-family: 'Space Mono', monospace; font-size: 9px; padding: 3px 10px; border: 1px solid #333; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }

  .comp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .comp-card { background: var(--panel); border: 1px solid #222; padding: 32px 28px; position: relative; overflow: hidden; transition: all 0.45s ease; cursor: default; }
  .comp-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 0.45s ease; }
  .comp-card:hover::before { transform: scaleX(1); }
  .comp-card:hover { border-color: var(--gold); transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,0.4); }
  .comp-icon { font-size: 32px; margin-bottom: 16px; }
  .comp-card h3 { font-family: 'Playfair Display', serif; font-size: 18px; margin-bottom: 10px; color: var(--cream); }
  .comp-card p { font-size: 13px; color: #888; line-height: 1.6; }

  .film-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  .film-card { background: linear-gradient(180deg, #1a1a1a 0%, #0f0f0f 100%); border: 1px solid #222; position: relative; overflow: hidden; transition: all 0.5s ease; }
  .film-card:hover { border-color: var(--gold); transform: translateY(-10px); box-shadow: 0 25px 70px rgba(201,169,110,0.08); }
  .film-poster { height: 380px; position: relative; overflow: hidden; background: linear-gradient(135deg, #1a0a0a, #2a1515); }
  .film-poster .poster-art { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size: 64px; color: rgba(201,169,110,0.08); font-weight: 900; letter-spacing: -2px; user-select: none; }
  .film-poster .poster-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 50%, transparent 100%); }
  .film-poster .poster-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 3; }
  .poster-play-btn { width: 60px; height: 60px; border: 2px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 18px; background: rgba(0,0,0,0.5); cursor: pointer; transition: all 0.35s ease; }
  .poster-play-btn:hover { background: var(--gold); color: var(--dark); transform: scale(1.15); }
  .film-poster .poster-badge { position: absolute; top: 16px; left: 16px; z-index: 4; padding: 4px 12px; font-family: 'Space Mono', monospace; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; background: rgba(201,169,110,0.15); color: var(--gold); border: 1px solid rgba(201,169,110,0.3); }
  .film-poster .poster-year { position: absolute; top: 16px; right: 16px; z-index: 4; font-family: 'Space Mono', monospace; font-size: 11px; color: var(--muted); }
  .film-info { padding: 28px 24px; }
  .film-info h3 { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700; color: var(--cream); margin-bottom: 8px; }
  .film-info .film-meta { font-family: 'Space Mono', monospace; font-size: 10px; color: var(--muted); letter-spacing: 1px; margin-bottom: 12px; }
  .film-info p { font-size: 13px; color: #777; line-height: 1.6; margin-bottom: 16px; }
  .film-cta { display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid #222; }
  .film-price { font-family: 'Space Mono', monospace; font-size: 14px; color: var(--gold); font-weight: 700; }
  .film-price .strike { color: #555; text-decoration: line-through; font-size: 11px; margin-left: 6px; }
  .film-unlock { background: transparent; color: var(--gold); border: 1px solid var(--gold); padding: 8px 16px; font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .film-unlock:hover { background: var(--gold); color: var(--dark); }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 40px; padding: 60px; background: var(--charcoal); border-top: 1px solid #1a1a1a; border-bottom: 1px solid #1a1a1a; text-align: center; }
  .stat-num { font-family: 'Playfair Display', serif; font-size: 40px; font-weight: 900; color: var(--gold); line-height: 1; }
  .stat-label { font-family: 'Space Mono', monospace; font-size: 10px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; margin-top: 8px; }

  .shop-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .shop-card { background: var(--panel); border: 1px solid #222; border-radius: 3px; overflow: hidden; transition: all 0.4s ease; }
  .shop-card:hover { border-color: var(--gold); transform: scale(1.02); box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .shop-thumb { height: 200px; position: relative; overflow: hidden; background: linear-gradient(135deg, #1a1a1a, #2a2a2a); display: flex; align-items: center; justify-content: center; }
  .shop-thumb::before { content: ''; position: absolute; width: 200%; height: 200%; background: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(201,169,110,0.02) 10px, rgba(201,169,110,0.02) 20px); animation: diagSlide 18s linear infinite; }
  @keyframes diagSlide { 0% { transform: translate(-50%,-50%); } 100% { transform: translate(0,0); } }
  .shop-play { width: 54px; height: 54px; border: 2px solid var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--gold); font-size: 16px; background: rgba(0,0,0,0.4); position: relative; z-index: 2; cursor: pointer; transition: all 0.3s; }
  .shop-play:hover { background: var(--gold); color: var(--dark); transform: scale(1.1); }
  .shop-badge { position: absolute; top: 12px; left: 12px; z-index: 3; padding: 3px 10px; font-family: 'Space Mono', monospace; font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; }
  .badge-free { background: rgba(34,197,94,0.15); color: var(--green); border: 1px solid rgba(34,197,94,0.3); }
  .badge-prem { background: rgba(201,169,110,0.15); color: var(--gold); border: 1px solid rgba(201,169,110,0.3); }
  .badge-series { background: rgba(139,69,19,0.3); color: #d4a574; border: 1px solid rgba(212,165,116,0.3); }
  .shop-info { padding: 24px; }
  .shop-meta { display: flex; gap: 12px; margin-bottom: 8px; font-family: 'Space Mono', monospace; font-size: 10px; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }
  .shop-info h3 { font-family: 'Playfair Display', serif; font-size: 17px; font-weight: 700; color: var(--cream); margin-bottom: 8px; }
  .shop-info p { font-size: 13px; color: #777; line-height: 1.5; margin-bottom: 16px; }
  .shop-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 14px; border-top: 1px solid #222; }
  .shop-price { font-family: 'Space Mono', monospace; font-size: 13px; color: var(--gold); font-weight: 700; }
  .shop-btn { background: transparent; color: var(--gold); border: 1px solid var(--gold); padding: 7px 14px; font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .shop-btn:hover { background: var(--gold); color: var(--dark); }

  .tier-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; align-items: start; }
  .tier-card { background: var(--panel); border: 1px solid #222; padding: 40px 32px; position: relative; transition: all 0.4s ease; }
  .tier-card.featured { border-color: var(--gold); transform: scale(1.03); box-shadow: 0 0 60px rgba(201,169,110,0.08); }
  .tier-card.featured::before { content: 'MOST POPULAR'; position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--gold); color: var(--dark); padding: 4px 16px; font-family: 'Space Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
  .tier-card:hover { border-color: var(--gold); transform: translateY(-4px); }
  .tier-card.featured:hover { transform: scale(1.03) translateY(-4px); }
  .tier-name { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: var(--cream); margin-bottom: 6px; }
  .tier-desc { font-size: 13px; color: var(--muted); margin-bottom: 24px; }
  .tier-price { font-family: 'Playfair Display', serif; font-size: 40px; font-weight: 900; color: var(--gold); line-height: 1; }
  .tier-price span { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: var(--muted); }
  .tier-list { list-style: none; margin: 32px 0; }
  .tier-list li { padding: 10px 0; border-bottom: 1px solid #1a1a1a; font-size: 14px; color: #999; display: flex; align-items: center; gap: 10px; }
  .tier-list li::before { content: '✓'; color: var(--gold); font-weight: 700; }
  .tier-btn { width: 100%; padding: 14px; background: var(--gold); color: var(--dark); border: none; font-family: 'Space Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer; transition: all 0.3s; }
  .tier-btn:hover { background: var(--gold-light); box-shadow: 0 10px 30px rgba(201,169,110,0.2); }
  .tier-btn.outline { background: transparent; color: var(--gold); border: 1px solid var(--gold); }
  .tier-btn.outline:hover { background: var(--gold); color: var(--dark); }

  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
  .skill-row { display: flex; flex-direction: column; gap: 8px; }
  .skill-label { display: flex; justify-content: space-between; font-size: 14px; }
  .skill-label span:first-child { color: var(--cream); } .skill-label span:last-child { font-family: 'Space Mono', monospace; color: var(--gold); font-size: 11px; }
  .skill-track { height: 3px; background: #222; border-radius: 2px; overflow: hidden; }
  .skill-fill { height: 100%; background: linear-gradient(90deg, var(--gold), var(--gold-light)); border-radius: 2px; animation: fillBar 1.8s ease-out forwards; transform-origin: left; transform: scaleX(0); }
  @keyframes fillBar { to { transform: scaleX(1); } }

  .pub-card { display: flex; gap: 24px; padding: 28px; background: linear-gradient(90deg, rgba(201,169,110,0.03), transparent); border-left: 3px solid var(--gold); margin-bottom: 16px; transition: all 0.3s ease; }
  .pub-card:hover { background: linear-gradient(90deg, rgba(201,169,110,0.06), transparent); padding-left: 32px; }
  .pub-year { font-family: 'Space Mono', monospace; font-size: 11px; color: var(--gold); white-space: nowrap; padding-top: 4px; }
  .pub-card h3 { font-family: 'Playfair Display', serif; font-size: 18px; color: var(--cream); margin-bottom: 6px; }
  .pub-card p { color: var(--muted); font-size: 13px; }

  .ref-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .ref-card { padding: 28px; background: var(--panel); border: 1px solid #222; transition: all 0.3s ease; }
  .ref-card:hover { border-color: var(--gold); }
  .ref-card h3 { font-family: 'Playfair Display', serif; font-size: 17px; color: var(--cream); margin-bottom: 4px; }
  .ref-role { font-size: 12px; color: var(--gold); margin-bottom: 14px; }
  .ref-card a { color: var(--muted); text-decoration: none; font-size: 13px; display: block; margin-bottom: 5px; transition: color 0.3s; }
  .ref-card a:hover { color: var(--gold); }

  .site-footer { padding: 80px 60px 40px; background: var(--charcoal); border-top: 1px solid #1a1a1a; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto 60px; }
  .footer-brand .f-logo { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 900; color: var(--cream); margin-bottom: 14px; }
  .footer-brand p { font-size: 13px; color: var(--muted); line-height: 1.7; }
  .footer-col h4 { font-family: 'Space Mono', monospace; font-size: 11px; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 18px; }
  .footer-col a { display: block; color: var(--muted); text-decoration: none; font-size: 13px; margin-bottom: 10px; transition: color 0.3s; }
  .footer-col a:hover { color: var(--cream); }
