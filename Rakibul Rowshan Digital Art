<script>
(function() {
  var nav = document.getElementById('mainNav');
  window.addEventListener('scroll', function() {
    if (window.scrollY > 50) nav.classList.add('scrolled');
    else nav.classList.remove('scrolled');
  });

  var revealObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) entry.target.classList.add('active');
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
  document.querySelectorAll('.reveal').forEach(function(el) { revealObs.observe(el); });

  var tlObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.timeline-item').forEach(function(el) { tlObs.observe(el); });

  var skillObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        var fills = entry.target.querySelectorAll('.skill-fill');
        fills.forEach(function(fill, i) {
          setTimeout(function() {
            fill.style.animation = 'none'; fill.offsetHeight;
            fill.style.animation = 'fillBar 1.8s ease-out forwards';
          }, i * 120);
        });
      }
    });
  }, { threshold: 0.2 });
  document.querySelectorAll('.skills-grid').forEach(function(el) { skillObs.observe(el); });

  window.addEventListener('scroll', function() {
    var scrolled = window.pageYOffset;
    var heroTitle = document.querySelector('.hero h1');
    if (heroTitle && scrolled < window.innerHeight) {
      heroTitle.style.transform = 'translateY(' + (scrolled * 0.12) + 'px)';
    }
  });
})();
</script>
